# Local development. Copy to .env: `cp .env.example .env`, then `make run`.
# These values only work with a loopback APP_URL: Open MCP Portal refuses to
# start on any other APP_URL with the example ENCRYPTION_KEY below, with
# DEV_AUTH=true, or with an http:// APP_URL.
# `open-mcp-portal doctor` checks the configuration, Postgres and migrations.
APP_URL=http://localhost:8088
LISTEN_ADDR=127.0.0.1:8088
DATABASE_URL=postgres://omp:omp-dev-only@127.0.0.1:55442/omp?sslmode=disable
MIGRATE_ON_START=true
LOG_FORMAT=text
LOG_LEVEL=debug
SHUTDOWN_DELAY=0s

# Encrypts secrets stored in the database (MCP server header values).
# Development-only value, refused off loopback; generate your own with:
# openssl rand -base64 32
ENCRYPTION_KEY=94cwGQfaKGZdfF4A04/lGwT/LMSckeFIpgC3FO3lnm8=
# Rotation: the old key, still accepted for reads until `open-mcp-portal
# rotate-keys` re-encrypts every stored value (docs/deploy.md "Key rotation").
# ENCRYPTION_KEY_PREVIOUS=

# Keys the HMAC under which personal API keys are stored (only digests are
# kept). Development-only value, refused off loopback; generate your own with
# openssl rand -base64 32. Changing it invalidates every API key unless the
# old value is kept as API_KEY_PEPPER_PREVIOUS for a while.
API_KEY_PEPPER=8gqQZFiYFPRaAwu73Ub9+AF0PVc3ZX6rEPR2CcFymgY=
# Rotation: the old pepper. Keys and connected apps made with it keep working
# (keys are re-digested on use); remove it after 2-4 weeks.
# API_KEY_PEPPER_PREVIOUS=

# Prometheus metrics at /metrics on their own listener (empty: off). No
# authentication: restrict it to your monitoring (NetworkPolicy).
# METRICS_ADDR=127.0.0.1:9090
# METRICS_MAX_OBJECTS=200           # gateway, server and provider slugs used as labels (others: other)

# Retention (periods are set in Admin › Retention): how often old call
# records, captured payloads, audit entries and usage rollups are deleted,
# and how many rows one transaction deletes. One replica runs it at a time.
# RETENTION_INTERVAL=15m
# RETENTION_BATCH_SIZE=1000

# How often enabled MCP servers are re-tested (0 turns it off; one replica
# runs it at a time).
# HEALTH_CHECK_INTERVAL=5m

# Internal networks and hosts MCP servers may use, besides public addresses
# (docs/registry.md "Security"). Comma-separated: a network or address
# (cidr) or a host name, *.suffix for its subdomains only (host); prefix an
# entry with http: to also allow plain http for it. Shown read-only in
# Admin › Internal networks, where platform admins add their own. Loopback,
# link-local and cloud metadata addresses stay blocked whatever this says.
# Invalid entries stop the server from starting.
# UPSTREAM_ALLOWED_NETWORKS=10.20.0.0/16,http:*.svc.cluster.local,mcp.corp.example.com

# How long a new identity signing key is published in the JWKS before it
# starts signing (keys rotate every 30 days; 0 to 7 days).
# SIGNING_KEY_PREPUBLISH=24h

# Local-only sign-in with fixed personas: admin (platform admin), auditor
# (platform auditor), and user, alex, blair and casey (no platform role).
# Refused unless APP_URL is loopback. Never enable on a reachable host.
# Each persona signs in with sample IdP groups, to try gateway group grants:
# admin: platform-admins; auditor: auditors; user and alex: engineering;
# blair and casey: support (every persona is also in everyone).
DEV_AUTH=true

# Instance identity. Nothing in the product names an organisation; each
# deployment sets its own.
# INSTANCE_NAME=Open MCP Portal  # product name in the UI and page titles (quote values with spaces)
# ORG_NAME=                       # e.g. "Example Corp"
# UI_THEME=neutral                # neutral (the only theme)
# UI_LOGO_URL=                    # https URL or same-origin path, e.g. https://www.example.com/logo.svg
# SUPPORT_URL=                    # "Help" link: http(s) URL or mailto: address

# Where people request a team (for example a service desk request form).
# TEAM_REQUEST_URL=https://help.example.com/new-team

# Sessions and limits (defaults shown). Counted in PostgreSQL, shared by
# every replica. Limits on /mcp/{slug} are set in Admin › Limits.
# SESSION_TTL=12h
# REQUESTS_PER_MINUTE=600
# LOGIN_ATTEMPTS_PER_MINUTE=20
# TRUSTED_PROXIES=                  # ingress CIDRs allowed to set X-Forwarded-For, e.g. 10.0.0.0/8

# Real single sign-on (any OIDC provider). Leave OIDC_ISSUER empty to disable.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=               # or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OIDC_SCOPES=openid,profile,email
# OIDC_EMAIL_CLAIM=email
# OIDC_GROUPS_CLAIM=groups            # the claim with the person's groups (for gateway grants); empty: none
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com   # empty: anyone the provider signs in
# The OIDC subject made platform admin on its first sign-in (once; a later
# demotion is not undone by signing in again).
# BOOTSTRAP_ADMIN_SUBJECT=
