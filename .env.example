# Local development. Copy to .env: `cp .env.example .env`, then `make run`.
# These values only work with a loopback APP_URL: Open MCP Gateway refuses to
# start on any other APP_URL with the example ENCRYPTION_KEY below, with
# DEV_AUTH=true, or with an http:// APP_URL.
# `open-mcp-gateway doctor` checks the configuration, Postgres and migrations.
APP_URL=http://localhost:8088
LISTEN_ADDR=127.0.0.1:8088
DATABASE_URL=postgres://omg:omg-dev-only@127.0.0.1:55442/omg?sslmode=disable
MIGRATE_ON_START=true
LOG_FORMAT=text
LOG_LEVEL=debug
SHUTDOWN_DELAY=0s

# Encrypts secrets stored in the database (MCP server header values).
# Development-only value, refused off loopback; generate your own with:
# openssl rand -base64 32
ENCRYPTION_KEY=94cwGQfaKGZdfF4A04/lGwT/LMSckeFIpgC3FO3lnm8=
# Rotation: the old key, still accepted for reads until values are re-entered.
# ENCRYPTION_KEY_PREVIOUS=

# How often enabled MCP servers are re-tested (0 turns it off; one replica
# runs it at a time).
# HEALTH_CHECK_INTERVAL=5m

# Local-only sign-in with fixed personas: admin (platform admin), auditor
# (platform auditor), and user, alex, blair and casey (no platform role).
# Refused unless APP_URL is loopback. Never enable on a reachable host.
DEV_AUTH=true

# Instance identity. Nothing in the product names an organisation; each
# deployment sets its own.
# INSTANCE_NAME=Open MCP Gateway  # product name in the UI and page titles (quote values with spaces)
# ORG_NAME=                       # e.g. "Example Corp"
# UI_THEME=neutral                # neutral (the only theme)
# UI_LOGO_URL=                    # https URL or same-origin path, e.g. https://www.example.com/logo.svg
# SUPPORT_URL=                    # "Help" link: http(s) URL or mailto: address

# Where people request a team (for example a service desk request form).
# TEAM_REQUEST_URL=https://help.example.com/new-team

# Sessions and limits (defaults shown). Rate limits are counted per process.
# SESSION_TTL=12h
# REQUESTS_PER_MINUTE=600
# LOGIN_ATTEMPTS_PER_MINUTE=20
# TRUSTED_PROXIES=                  # ingress CIDRs allowed to set X-Forwarded-For, e.g. 10.0.0.0/8

# Real single sign-on (any OIDC provider). Leave OIDC_ISSUER empty to disable.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=               # or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OIDC_SCOPES=openid,profile,email
# OIDC_EMAIL_CLAIM=email
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com   # empty: anyone the provider signs in
# The OIDC subject made platform admin on its first sign-in (once; a later
# demotion is not undone by signing in again).
# BOOTSTRAP_ADMIN_SUBJECT=
