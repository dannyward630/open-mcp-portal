# open-mcp-portal-config: non-secret settings (docs/deploy.md,
# "Configuration"). Every setting is described in .env.example. Values are
# literal (no quotes). Overlays merge their own keys. Secrets (DATABASE_URL,
# ENCRYPTION_KEY, API_KEY_PEPPER, OIDC_CLIENT_SECRET) come from the secret
# open-mcp-portal-runtime, never from here.
#
# The public https origin people and MCP clients reach the portal at; it
# must match the Ingress host. Placeholder: overlays set it.
APP_URL=https://mcp.example.org
LISTEN_ADDR=:8088
LOG_FORMAT=json
LOG_LEVEL=info
# Refused on a non-loopback APP_URL anyway; stated for clarity.
DEV_AUTH=false
# Migrations run in the migrate init container (also pinned in the
# Deployment).
MIGRATE_ON_START=false
# Single sign-on. Placeholders: overlays set the issuer and client ID.
OIDC_ISSUER=https://idp.example.org
OIDC_CLIENT_ID=open-mcp-portal
# Internal networks and hosts MCP servers may use besides public addresses
# (docs/deploy.md, "Internal MCP servers"); http: also allows plain http.
# The egress NetworkPolicies must allow these networks and ports too.
# UPSTREAM_ALLOWED_NETWORKS=10.20.0.0/16,http:*.svc.cluster.local
# Prometheus metrics on their own listener (docs/deploy.md, "Metrics"),
# off by default and without authentication. To enable: set METRICS_ADDR
# (for example :9090), add the container port "metrics" (commented in
# deployment.yaml) and a NetworkPolicy from your monitoring namespace;
# overlays/example does all three.
# METRICS_ADDR=:9090
# Retention (periods are set in Admin › Retention): run interval and rows
# per transaction. One replica runs it at a time.
# RETENTION_INTERVAL=15m
# RETENTION_BATCH_SIZE=1000
# Graceful shutdown: /readyz fails, SHUTDOWN_DELAY lets load balancers
# notice, then in-flight requests get SHUTDOWN_TIMEOUT. MCP calls can wait
# up to 120s for an upstream server (the per-server timeout maximum), so the
# timeout covers that. Keep terminationGracePeriodSeconds (150s) above
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT + a few seconds; raise them together.
SHUTDOWN_DELAY=10s
SHUTDOWN_TIMEOUT=125s
