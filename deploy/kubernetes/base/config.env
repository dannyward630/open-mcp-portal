# open-mcp-gateway-config: non-secret settings (docs/deploy.md,
# "Configuration"). Every setting is described in .env.example. Values are
# literal (no quotes). Overlays merge their own keys. Secrets (DATABASE_URL,
# ENCRYPTION_KEY, API_KEY_PEPPER, OIDC_CLIENT_SECRET) come from the secret
# open-mcp-gateway-runtime, never from here.
#
# The public https origin people and MCP clients reach the gateway at; it
# must match the Ingress host. Placeholder: overlays set it.
APP_URL=https://mcp.example.org
LISTEN_ADDR=:8088
LOG_FORMAT=json
LOG_LEVEL=info
# Refused on a non-loopback APP_URL anyway; stated for clarity.
DEV_AUTH=false
# Migrations run in the migrate init container (also pinned in the
# Deployment).
MIGRATE_ON_START=false
# Single sign-on. Placeholders: overlays set the issuer and client ID.
OIDC_ISSUER=https://idp.example.org
OIDC_CLIENT_ID=open-mcp-gateway
# Graceful shutdown: /readyz fails, SHUTDOWN_DELAY lets load balancers
# notice, then in-flight requests get SHUTDOWN_TIMEOUT. MCP calls can wait
# up to 120s for an upstream server (the per-server timeout maximum), so the
# timeout covers that. Keep terminationGracePeriodSeconds (150s) above
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT + a few seconds; raise them together.
SHUTDOWN_DELAY=10s
SHUTDOWN_TIMEOUT=125s
